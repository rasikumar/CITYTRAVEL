# Database Configuration
# Defaults to SQLite if Postgres is not configured: sqlite:///./transitnow.db
# PostgreSQL with PostGIS: postgresql://postgres:postgres@localhost:5432/transitnow
DATABASE_URL=sqlite:///./transitnow.db

# JWT Secret
SECRET_KEY=transitnow-super-secret-key-development-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Cache & PubSub (optional, falls back to in-memory broadcast if not running)
REDIS_URL=redis://localhost:6379/0

# App Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
